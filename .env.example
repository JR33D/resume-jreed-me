# ── Blog content repo ────────────────────────────────────────────────────────
# Raw base URL of your external blog content repo (no trailing slash).
#
# GitHub public repo:
#   BLOG_CONTENT_URL=https://raw.githubusercontent.com/jr33d/blog-content/main
#
# Gitea public repo:
#   BLOG_CONTENT_URL=https://your.gitea.host/jr33d/blog-content/raw/branch/main
#
# For private repos also set BLOG_CONTENT_TOKEN (a personal access token with
# read:packages / repo scope — Gitea: Settings → Applications → Access Tokens)
BLOG_CONTENT_URL=
BLOG_CONTENT_TOKEN=

# ── Contact form (SMTP2GO) ────────────────────────────────────────────────────
# API key from app.smtp2go.com → Settings → API Keys
SMTP2GO_API_KEY=
# Verified sender address in your SMTP2GO account
SMTP2GO_FROM_EMAIL=
# Where contact form messages are delivered (defaults to contact@jreed.me)
CONTACT_TO_EMAIL=
